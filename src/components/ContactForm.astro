---
import { site } from '../config';

const hasRecaptcha = Boolean(site.recaptchaSiteKey);
---

<section id="contact" class="section contact" aria-labelledby="contact-heading">
  <div class="container contact-inner">
    <div class="contact-intro">
      <h2 id="contact-heading" class="section-heading">Contact</h2>
    </div>

    <form
      class="contact-form"
      action={site.formEndpoint}
      method="POST"
      data-contact-form
      data-recaptcha-enabled={String(hasRecaptcha)}
    >
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>

      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>

      {
        hasRecaptcha && (
          <div class="recaptcha-field" data-recaptcha-field>
            <div class="g-recaptcha" data-sitekey={site.recaptchaSiteKey} data-size="compact" />
          </div>
        )
      }

      <button type="submit" class="submit-btn">Submit</button>
      <p class="form-status" role="status" aria-live="polite" data-contact-status></p>

      <p class="form-privacy">
        Privacy policy: if you use the contact form, your data is only stored and used to reply to
        your inquiry. Otherwise, your data is not stored or used.
      </p>
    </form>
  </div>
</section>

{hasRecaptcha && <script is:inline src="https://www.google.com/recaptcha/api.js" async defer />}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-contact-status]');
  const recaptchaField = document.querySelector<HTMLElement>('[data-recaptcha-field]');

  recaptchaField?.setAttribute('hidden', '');

  type FormspreeError = {
    code?: string;
    field?: string;
    message?: string;
  };

  type FormspreeResponse = {
    error?: string;
    errors?: FormspreeError[];
  };

  const resetRecaptcha = () => {
    const recaptcha = (
      window as Window & typeof globalThis & { grecaptcha?: { reset: () => void } }
    ).grecaptcha;

    recaptcha?.reset();
  };

  const getFormspreeErrorMessage = async (response: Response) => {
    const fallback = 'Something went wrong. Please try again.';

    try {
      if (!response.headers.get('content-type')?.includes('application/json')) {
        return (await response.text()) || fallback;
      }

      const result = (await response.json()) as FormspreeResponse;
      const error = result.errors?.[0];
      const message = error?.message ?? result.error;
      const code = error?.code?.toLowerCase() ?? '';
      const field = error?.field?.toLowerCase() ?? '';

      if (field === 'g-recaptcha-response' || code.includes('captcha')) {
        status?.setAttribute('data-state', 'warning');
        return 'Please complete the verification and try again.';
      }

      return message || fallback;
    } catch {
      return fallback;
    }
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!status) return;

    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const originalButtonText = submitButton?.textContent ?? 'Submit';
    const formData = new FormData(form);
    const recaptchaEnabled = form.dataset.recaptchaEnabled === 'true';

    if (recaptchaEnabled && !String(formData.get('g-recaptcha-response') ?? '').trim()) {
      recaptchaField?.removeAttribute('hidden');
      status.textContent = 'Please complete the verification.';
      status.dataset.state = 'warning';
      return;
    }

    status.textContent = 'Sending...';
    status.dataset.state = 'pending';
    submitButton?.setAttribute('disabled', 'true');
    if (submitButton) submitButton.textContent = 'Sending...';

    try {
      const response = await fetch(form.action, {
        method: form.method,
        body: formData,
        headers: {
          Accept: 'application/json',
        },
      });

      if (!response.ok) {
        status.textContent = await getFormspreeErrorMessage(response);
        status.dataset.state = 'error';
        recaptchaField?.removeAttribute('hidden');
        resetRecaptcha();
        return;
      }

      form.reset();
      resetRecaptcha();
      recaptchaField?.setAttribute('hidden', '');
      status.textContent = 'Thank you. Your message has been sent.';
      status.dataset.state = 'success';
    } catch (error) {
      console.error('Contact form submission failed.', error);
      status.textContent = 'Something went wrong. Please try again.';
      status.dataset.state = 'error';
    } finally {
      submitButton?.removeAttribute('disabled');
      if (submitButton) submitButton.textContent = originalButtonText;
    }
  });
</script>
