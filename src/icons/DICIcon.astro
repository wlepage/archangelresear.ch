---
// Reference grid deforming into displacement vectors.
---

<svg
  class="product-icon"
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <!-- undeformed reference grid -->
  <rect x="8" y="8" width="20" height="20" rx="1" stroke-dasharray="2 2.5"></rect>
  <line x1="8" y1="18" x2="28" y2="18" stroke-dasharray="2 2.5"></line>
  <line x1="18" y1="8" x2="18" y2="28" stroke-dasharray="2 2.5"></line>
  <!-- deformed (sheared) grid -->
  <path d="M16 20 L 40 20 L 36 40 L 12 40 Z"></path>
  <line x1="28" y1="20" x2="24" y2="40"></line>
  <line x1="14" y1="30" x2="38" y2="30"></line>
  <!-- displacement vector -->
  <line x1="18" y1="18" x2="26" y2="30"></line>
  <path d="M26 30 l -3.6 -0.4 M26 30 l -0.6 -3.4"></path>
</svg>
