---
// Extreme-value distribution curve with a highlighted tail point.
---

<svg
  class="product-icon"
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <!-- baseline -->
  <line x1="6" y1="38" x2="42" y2="38"></line>
  <!-- skewed extreme-value curve -->
  <path d="M6 38 C 13 38, 16 14, 22 14 C 28 14, 30 30, 36 35 C 39 37, 41 38, 42 38"></path>
  <!-- highlighted tail point -->
  <circle cx="36" cy="35" r="2.4" fill="currentColor" stroke="none"></circle>
  <line x1="36" y1="35" x2="36" y2="38" stroke-dasharray="2 2.5"></line>
</svg>
