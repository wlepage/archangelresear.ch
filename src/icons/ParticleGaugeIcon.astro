  <line x1="39" y1="10" x2="39" y2="30"></line>
  <line x1="9" y1="14" x2="39" y2="14" stroke-dasharray="2 2.5"></line>
  <!-- merged particle / stringer outlines -->
  <path d="M15 24 q 3 -6 8 -3 q 6 -3 9 3 q 2 5 -3 7 q -8 4 -13 -1 q -3 -3 -1 -6 Z"></path>
  <circle cx="20" cy="24" r="1.4" fill="currentColor" stroke="none"></circle>
  <circle cx="28" cy="26" r="1.4" fill="currentColor" stroke="none"></circle>
