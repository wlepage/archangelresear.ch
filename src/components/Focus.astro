---
import { focusAreas, focusIntro } from '../data/focus';
---

<section id="focus" class="section focus" aria-labelledby="focus-heading">
  <div class="container">
    <h2 id="focus-heading" class="section-heading">Current focus</h2>
    <p class="section-intro">{focusIntro}</p>
    <ul class="focus-grid" role="list">
      {
        focusAreas.map((area) => (
          <li class="focus-item">
            <h3 class="focus-title">{area.title}</h3>
            <p class="focus-detail">{area.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
