---
// Two separate filled lens-shaped stringers on a shared horizontal axis —
// thin, slightly asymmetric and differently sized, with a small gap between
// them — plus a dotted dimension line with bold arrowheads.
---

<svg
  class="product-icon"
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <!-- left stringer (larger, crest offset left) -->
  <path
    d="M7 19 C 11 16.1, 14 15.8, 17 16.6 C 19.5 17.2, 21.5 17.9, 23.5 19
       C 21.5 19.9, 19.5 20.7, 17 21.2 C 14 21.7, 11 21.4, 7 19 Z"
    fill="currentColor"
    stroke="none"></path>

  <!-- right stringer (smaller, slightly different profile) -->
  <path
    d="M26.5 19 C 29 17.1, 31.5 16.9, 34 17.1 C 36 17.4, 38 18, 40 19
       C 38 19.8, 36 20.5, 34 20.8 C 31.5 21.1, 29 21.2, 26.5 19 Z"
    fill="currentColor"
    stroke="none"></path>

  <!-- dotted extension lines + solid dimension line -->
  <line x1="7" y1="23" x2="7" y2="35" stroke-dasharray="0.5 3"></line>
  <line x1="40" y1="23" x2="40" y2="35" stroke-dasharray="0.5 3"></line>
  <line x1="7" y1="33" x2="40" y2="33"></line>

  <!-- bold filled arrowheads -->
  <path d="M7 33 L12.6 30 L12.6 36 Z" fill="currentColor" stroke="none"></path>
  <path d="M40 33 L34.4 30 L34.4 36 Z" fill="currentColor" stroke="none"></path>
</svg>
